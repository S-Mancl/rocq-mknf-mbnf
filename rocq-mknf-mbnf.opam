opam-version: "2.0"
synopsis: "Propositional MKNF and MBNF syntax, semantics, and verified reasoning"
description: """
A Rocq formalization of propositional minimal knowledge and negation as
failure (MKNF) and minimal belief and negation as failure (MBNF).
Includes finite enumeration, model semantics, verified entailment and
countermodel procedures, Rosati-style partition algorithms, and a worked
murder mystery example.
"""
maintainer: "S-Mancl <115006888+S-Mancl@users.noreply.github.com>"
authors: ["S-Mancl"]
license: "MIT"
homepage: "https://github.com/S-Mancl/rocq-mknf-mbnf"
doc: "https://github.com/S-Mancl/rocq-mknf-mbnf/blob/main/README.md"
bug-reports: "https://github.com/S-Mancl/rocq-mknf-mbnf/issues"
dev-repo: "git+https://github.com/S-Mancl/rocq-mknf-mbnf.git"
depends: [
  "rocq-core" {>= "9.1.0" & < "9.2~"}
  "rocq-stdlib" {>= "9.0.0" & < "9.1~"}
]
build: [
  [make "-j%{jobs}%"]
  [make "check"] {with-test}
  [make "html"] {with-doc}
]
install: [make "install"]
tags: [
  "keyword:nonmonotonic logic"
  "keyword:MKNF"
  "keyword:MBNF"
  "logpath:MKNF"
]
